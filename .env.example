# AI backend for source-neutral/manual Synapse ingestion.
# Recommended controlled-E2E path: direct Gemini Developer API.
AI_PROVIDER=gemini
GEMINI_API_KEY=replace_me
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional compatibility backend. Keep these only when AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=replace_me
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
# OpenRouter provider slug for DeepInfra.
OPENROUTER_PROVIDER=deepinfra
# Keep false to fail explicitly instead of silently using another provider.
OPENROUTER_ALLOW_FALLBACKS=false
# Reject providers that cannot honor response_format/reasoning parameters.
OPENROUTER_REQUIRE_PARAMETERS=true
# Optional attribution headers. Set a real production URL when available.
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=Synapse IDX Engine

IDX_BASE_URL=https://www.idx.co.id
IDX_PAGE_SIZE=50
IDX_REQUEST_DELAY_SECONDS=0.35
IDX_USER_AGENT=SynapseIDXEngine/0.16.0 (+your-email@example.com)
# Only set this for explicit manual/browser diagnostics. Never commit it.
IDX_COOKIE=

# Generic/manual engine transport. Existing research CLI may use browser fallback.
IDX_TRANSPORT=auto
IDX_BROWSER_PROFILE_DIR=./data/browser-profile
IDX_BROWSER_HEADLESS=false
IDX_BROWSER_NAVIGATION_TIMEOUT_MS=60000
IDX_BROWSER_VERIFICATION_TIMEOUT_SECONDS=180

# Synapse internal API. Keep secrets in runtime/GitHub Actions secrets, never Git.
# Production boundary E2E is verified; use the deployed Synapse origin as the base URL.
SYNAPSE_INTERNAL_BASE_URL=
SYNAPSE_INGESTION_SECRET=

# Scheduled Synapse collection remains OFF until an approved/licensed source is integrated.
SYNAPSE_DAILY_ENABLED=false
# Non-negotiable scheduled policy: HTTP only; stop on 403/access protection.
SYNAPSE_DAILY_TRANSPORT=http
SYNAPSE_DAILY_REQUEST_DELAY_SECONDS=1.5
SYNAPSE_DAILY_REQUEST_JITTER_SECONDS=0.35
SYNAPSE_DAILY_MAX_SOURCE_REQUESTS=50
SYNAPSE_DAILY_MAX_ATTACHMENTS=100
SYNAPSE_DAILY_MAX_DOWNLOAD_BYTES=500000000
SYNAPSE_DAILY_MAX_AI_DOCUMENTS=100
SYNAPSE_DAILY_MAX_RUN_SECONDS=2700
SYNAPSE_DAILY_ALLOW_HISTORICAL_BACKFILL=false
SYNAPSE_DAILY_ALLOW_TICKER_FANOUT=false

APP_TIMEZONE=Asia/Jakarta
DATA_DIR=./data
OCR_LANG=ind+eng
OCR_MIN_CHARS_PER_PAGE=80
MAX_XLSX_CELLS=250000
LLM_CHUNK_CHARS=45000
